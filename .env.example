# Versiones de imagen
PHP_VERSION=8.4
NGINX_VERSION=1.27
POSTGRES_VERSION=17

# PostgreSQL
POSTGRES_DB=gestor_recibos
POSTGRES_USER=gestor_recibos
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# nginx
NGINX_PORT=9010

# Ollama externo (otro docker-compose en la misma máquina, junto a OpenWebUI)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Volúmenes nombrados
POSTGRES_DATA_VOLUME=gestor_recibos_postgres_data
DOCUMENTS_VOLUME=gestor_recibos_documents
